{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "allowJs": true,
    "types": [
      "bun"
    ],
    // Bundler mode
    "moduleResolution": "bundler",
    "paths": {
      "amux": [
        "./packages/amux/src/api.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Enable after the existing unused-symbol backlog is cleaned up.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "abortControllerInEffect": "error",
          "asyncFunction": "error",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "extendsNativeError": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "newPromise": "error",
          "nodeBuiltinImport": "suggestion",
          "preferSchemaOverJson": "warning",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "unsafeEffectTypeAssertion": "error"
        }
      }
    ]
  },
  "exclude": ["scripts", "tools"]
}
