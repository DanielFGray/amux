{
  "name": "@danielfgray/amux",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielfgray/amux"
  },
  "bin": {
    "amux": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "module": "src/main.tsx",
  "scripts": {
    "start": "bun src/main.tsx",
    "daemon": "bun src/daemon-main.ts",
    "session": "bun src/session-cli.ts",
    "cli": "bun src/cli.ts",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx oxfmt --write src e2e",
    "format:check": "bunx oxfmt --check src e2e",
    "test": "bun test src",
    "lint": "oxlint src e2e",
    "lint:fix": "oxlint --fix src e2e",
    "build:shim": "cc -shared -fPIC -o vendor/libamux-shim.so src/shim.c -Lvendor/libghostty-vt/zig-out/lib -lghostty-vt -lutil -Wl,-rpath,'$ORIGIN/libghostty-vt/zig-out/lib'",
    "build:help": "bun src/cli.ts --help",
    "build:compile": "mkdir -p build && cp bun.lock package.json build/ && printf '[install]\\nexact = true\\n' > build/bunfig.toml && ln -sf \"$PWD/node_modules\" build/node_modules && cp vendor/libamux-shim.so build/ && BUN_CONFIG_NO_PRELOAD=1 bun build --compile src/cli.ts --outfile build/amux && echo 'Run with: cd build && ./amux'",
    "e2e": "bun test e2e",
    "prepare": "bun run build:shim && effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/ai": "0.37.0",
    "@effect/ai-anthropic": "0.27.0",
    "@effect/ai-openai": "0.41.0",
    "@effect/platform-bun": "0.91.2",
    "@opentui/core": "^0.5.1",
    "@opentui/keymap": "0.5.1",
    "@opentui/solid": "0.5.1",
    "effect": "^3.22.1",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@effect/tsgo": "0.34.0",
    "@effect/vitest": "^0.30.0",
    "@types/bun": "latest",
    "@oxlint/plugins": "1.78.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
